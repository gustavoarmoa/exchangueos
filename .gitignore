# Build
bin/
dist/
*.test
*.out
coverage.*
*.prof
*.exe

# Generated
proto/gen/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# Local data
docker/compose/data/
docker/compose/logs/
# data/* excludes runtime data subdirs but allows data/bacen/ (regulatory
# source-of-truth: CSV + golden corpus required for codegen + drift guard +
# accuracy harness). The negation only works because the parent itself
# (data/) is NOT excluded.
data/*
!data/bacen/
logs/

